{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mohammadali",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "195267df-a0e8-4475-b439-627ab2ab7efd","database_name": "Mohammadali" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "6181dd38b27f4b9aa95ed234f542e4fc" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
